.venv
.venv/
__pycache__/
*.pyc
*.pyo

# Large inputs are not redistributed; `src/config.py` points at a local data folder
# and the README gives the download commands.
datasets/
*.fa
*.fa.gz
*.fai

# LaTeX build products (the compiled PDFs themselves are tracked)
*.aux
*.log
*.out
*.blg
*.bbl
*.toc
*.fdb_latexmk
*.fls
*.spl
*.synctex.gz

# Model checkpoints are reproducible from the frozen seed
*.pt
*.ckpt

# Per-row predictions. The small ones are tracked because they are what the
# confirmatory and transfer claims are computed from. The unseen-sgRNA file is
# 234 MB -- past GitHub's 100 MB hard limit -- and is regenerable from the frozen
# seed with `python -m src.run guide`, so it is excluded. The per-sgRNA metric
# CSVs derived from it are tracked in full.
results/pred_guide.parquet

# The manuscript is deliberately NOT published here, to avoid any conflict with the
# target journal's prior-publication policy. The sources stay in the working tree so
# the pipeline still builds them; they are simply not tracked. Figures are copied to
# docs/figures/ by `python -m src.figures`, and those -- being outputs of the code in
# this repository rather than the article -- are tracked.
paper/
paper-csbj/
docs/*.pdf
